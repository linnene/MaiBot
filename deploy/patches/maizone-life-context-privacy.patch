+async def _fetch_public_life_context() -> str:
+    """Fetch only life-frequency's explicit public projection.
+
+    Failure is closed: no chat history or other private source is used as a
+    fallback.  The provider contract contains enum activities and numeric
+    wellbeing fields only.
+    """
+
+    config = plugin_context.config  # type: ignore
+    if not bool(getattr(config.send, "enable_life_context", True)):
+        return ""
+    logger = plugin_context.ctx.logger  # type: ignore
+    try:
+        payload = await asyncio.wait_for(
+            plugin_context.ctx.api.call(
+                "org.orge-8.life-frequency.get_public_life_state",
+                version="1",
+            ),
+            timeout=3.0,
+        )
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        logger.warning(f"读取公开生活状态失败，跳过该素材: {type(exc).__name__}: {exc}")
+        return ""
+    if not isinstance(payload, dict) or payload.get("success") is False or payload.get("ok") is False:
+        logger.warning("公开生活状态返回无效，跳过该素材")
+        return ""
+
+    activities = payload.get("today_activities")
+    activity_text = "、".join(str(item)[:20] for item in activities[-6:]) if isinstance(activities, list) else ""
+    lines = [
+        f"当前活动：{str(payload.get('current_activity') or '日常')[:20]}",
+        f"已持续约 {max(0, int(payload.get('activity_minutes') or 0))} 分钟",
+    ]
+    if activity_text:
+        lines.append(f"今天的活动轨迹：{activity_text}")
+    lines.extend(
+        [
+            f"心情 {float(payload.get('emotion') or 0):.1f}/10，体力 {float(payload.get('energy') or 0):.1f}/10",
+            f"身体：{str(payload.get('health') or '健康')[:30]}",
+            f"今天睡了 {float(payload.get('sleep_hours_today') or 0):.1f} 小时，吃了 {max(0, int(payload.get('meals_today') or 0))} 顿",
+        ]
+    )
+    return "\n".join(lines)
+
