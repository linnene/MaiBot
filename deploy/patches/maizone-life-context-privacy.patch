+    def _public_life_snapshot(self, now: float) -> dict[str, Any]:
+        """Return a deliberately small, privacy-safe view of her own day.
+
+        This contract never exposes scenes, materials, relations, session ids,
+        chat-derived events, or free-form event text.  The activity history is
+        reconstructed from enum-valued activity fields only.
+        """
 
+        state = self._state
+        day_start = datetime.fromtimestamp(now).replace(
+            hour=0, minute=0, second=0, microsecond=0
+        ).timestamp()
+        activities: list[str] = []
+        for item in state.recent_events:
+            if not isinstance(item, Mapping):
+                continue
+            try:
+                event_at = float(item.get("at") or 0.0)
+            except (TypeError, ValueError):
+                continue
+            activity = str(item.get("activity") or "")
+            if event_at < day_start or activity not in ALLOWED_ACTIVITIES:
+                continue
+            label = self._activity_label(activity)
+            if label and (not activities or activities[-1] != label):
+                activities.append(label)
+        current = self._activity_label(state.activity)
+        if current and (not activities or activities[-1] != current):
+            activities.append(current)
+        return {
+            "ok": True,
+            "as_of": datetime.fromtimestamp(now).isoformat(timespec="seconds"),
+            "current_activity": current,
+            "activity_minutes": max(0, int((now - float(state.activity_since or now)) / 60)),
+            "today_activities": activities[-6:],
+            "emotion": round(float(state.emotion), 1),
+            "energy": round(float(state.energy), 1),
+            "health": health_label_prompt(state, now, self._sim_config()),
+            "sleep_hours_today": round(float(sleep_hours_today(state)), 1),
+            "satiety": round(float(state.satiety), 1),
+            "meals_today": int(state.meal_count_today),
+            "privacy": "own_life_only",
+        }
+
