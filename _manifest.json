{
  "manifest_version": 2,
  "id": "local.curated-voice",
  "name": "精选表达参考（私聊试用）",
  "version": "0.1.0",
  "description": "仅向允许会话的简短回复提供最多一条向量匹配的表达示例；示例不是记忆，不改变人设。",
  "author": {
    "name": "Local development",
    "url": "https://github.com/linnene"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "hook",
  "capabilities": [
    "llm.embed"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "urls": {
    "repository": "https://github.com/linnene/MaiBot"
  }
}
