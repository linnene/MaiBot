{
  "manifest_version": 2,
  "id": "local.entertainment",
  "name": "兴趣阅读与自然分享",
  "version": "0.1.0",
  "description": "默认关闭的空闲只读小红书阅读、独立阅读批注与回执去重；分享由宿主与渠道插件负责。",
  "author": {
    "name": "Local development",
    "url": "https://github.com/linnene"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9,<4"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10"
    }
  ],
  "plugin_type": "extension",
  "capabilities": [
    "api.call",
    "llm.generate",
    "chat.get_private_streams",
    "chat.get_group_streams",
    "maisaka.proactive.trigger",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "urls": {
    "repository": "https://github.com/linnene/MaiBot"
  }
}
