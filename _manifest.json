{
  "manifest_version": 2,
  "id": "spica.easysvg-creator",
  "version": "1.1.0",
  "name": "SVG 简笔画生成器",
  "description": "一个用于生成和渲染简单 SVG 图像的插件。支持 LLM 自主调用生成动态 SVG 图像，可配置尺寸限制与默认背景色。",
  "author": {
    "name": "spica",
    "url": "https://github.com/sp1ca0722"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/sp1ca0722/maibot-easysvg-creator"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "resvg-py",
      "version_spec": "==0.4.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "image",
      "background": "#ffffff"
    }
  },
  "capabilities": [
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
